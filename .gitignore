# Brand Studio — reproducible runtime/cache exclusions, not a creative archive
# Legacy _archive remains excluded; reviewed unique material is preserved in archives/.
_archive/
asya-egitim-site.zip
**/share-runtime/
*.log
.DS_Store
**/.DS_Store
# NOTE: brands/*/share/ contains regenerated review-site copies of
# explorations/ originals (rebuilt anytime via /brand-share). Excluded
# to keep the repo lean; explorations/ originals ARE tracked.
**/share/
node_modules/

# Python bytecode caches
__pycache__/
*.pyc

# Cloud environments recreate these; secrets belong in the cloud vault.
.venv/
.cloud-runtime/
.env
.env.*
!.env.example
*.pem
*.key
