{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutputManifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^brandstudio-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 130
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "status": {
      "enum": [
        "draft",
        "prepared",
        "technical_verified",
        "creative_review",
        "accepted",
        "delivered"
      ]
    },
    "editable_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^docs/[A-Za-z0-9][A-Za-z0-9._/-]*$",
        "maxLength": 400,
        "not": {
          "pattern": "(?:^|/)\\.\\.?(/|$)|//|\\\\|[?&#]"
        }
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "renders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "width",
          "height",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "maxLength": 400,
            "not": {
              "pattern": "(?:^|/)\\.\\.?(/|$)|//|\\\\|[?&#]"
            }
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 100
    },
    "lockup": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_id",
            "sha256"
          ],
          "properties": {
            "canonical_id": {
              "type": "string",
              "pattern": "^[A-Z]-[0-9]{2}/(light|dark|monochrome)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources_verified",
        "logo_hash_verified",
        "pixel_inspected"
      ],
      "properties": {
        "sources_verified": {
          "type": "boolean"
        },
        "logo_hash_verified": {
          "type": "boolean"
        },
        "pixel_inspected": {
          "type": "boolean"
        }
      }
    },
    "human_approval_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^review:[a-zA-Z0-9][a-zA-Z0-9._-]{0,120}$"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "revision_id",
    "status",
    "editable_sources",
    "renders",
    "lockup",
    "checks",
    "human_approval_ref"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "prepared",
              "technical_verified",
              "creative_review",
              "accepted",
              "delivered"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "editable_sources": {
            "minItems": 1
          },
          "renders": {
            "minItems": 1
          },
          "lockup": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "technical_verified",
              "creative_review",
              "accepted",
              "delivered"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "sources_verified": {
                "const": true
              },
              "logo_hash_verified": {
                "const": true
              },
              "pixel_inspected": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "delivered"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "human_approval_ref": {
            "type": "string"
          }
        }
      }
    }
  ]
}
