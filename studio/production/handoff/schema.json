{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brandstudio P2 HandoffEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source_executor",
    "target_executor",
    "source_branch",
    "source_head_sha",
    "original_base_sha",
    "target_branch",
    "output_ref",
    "receipt_ref",
    "observed_via",
    "target_observed_via",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^brandstudio-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 130
    },
    "source_executor": {
      "enum": [
        "opencode",
        "codex",
        "chatgpt-work",
        "chatgpt-chat",
        "antigravity"
      ]
    },
    "target_executor": {
      "enum": [
        "opencode",
        "codex",
        "chatgpt-work",
        "chatgpt-chat",
        "antigravity"
      ]
    },
    "source_branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,180}$"
    },
    "target_branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,180}$"
    },
    "source_head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "original_base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "output_ref": {
      "type": "string",
      "pattern": "^docs/[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "maxLength": 400
    },
    "receipt_ref": {
      "type": "string",
      "pattern": "^docs/[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$",
      "maxLength": 400
    },
    "observed_via": {
      "enum": [
        "none",
        "github-connector",
        "git-remote"
      ]
    },
    "target_observed_via": {
      "enum": [
        "none",
        "github-connector",
        "git-remote"
      ]
    },
    "status": {
      "enum": [
        "prepared",
        "source_verified",
        "received"
      ]
    }
  }
}
