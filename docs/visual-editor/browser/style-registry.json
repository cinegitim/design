    {
      "style_id": "conceptual-breakout",
      "name": "Conceptual Breakout",
      "brand": "asyada-egitim",
      "category": "instagram-carousel",
      "version": "0.1.0",
      "status": "review-only",
      "source_path": "brands/asyada-egitim/styles/instagram-carousel/conceptual-breakout/style.json",
      "source_blob_sha": "47629d3af18421839568f019e311153c95b32a7e",
      "description": "A high-concept visual surprise built around one material or object metaphor, oversized shapes and editorial tension; distinct from both photographic campaign grids and data-atlas diagrams.",
      "default_preset": "object-metaphor",
      "presets": {
        "object-metaphor": {
          "label": "Nesne metaforu",
          "summary": "An oversized meaningful object anchors a narrative; plenty of brand-safe type space.",
          "variants": {
            "visual_metaphor": "object",
            "materiality": "clean-cutout",
            "layout_energy": "bold",
            "cover_device": "hero-object",
            "image_role": "concept-support",
            "sequence_arc": "hook-reveal"
          }
        },
        "typographic-shock": {
          "label": "Tipografik gerilim",
          "summary": "Bold Jost lettering and purposeful white space create a visual hook.",
          "variants": {
            "visual_metaphor": "type-tension",
            "materiality": "paper-layer",
            "layout_energy": "spacious",
            "cover_device": "oversized-type",
            "image_role": "minimal",
            "sequence_arc": "contrast-payoff"
          }
        },
        "editorial-collage": {
          "label": "Katmanlı kolaj",
          "summary": "Controlled paper/photo cutouts and staggered layout reveal a story in stages.",
          "variants": {
            "visual_metaphor": "collage",
            "materiality": "photo-stage",
            "layout_energy": "layered",
            "cover_device": "reveal-window",
            "image_role": "object-only",
            "sequence_arc": "journey"
          }
        }
      },
      "variation_axes": {
        "visual_metaphor": {
          "default": "object",
          "options": [
            "object",
            "type-tension",
            "collage"
          ],
          "description": "Central expressive device for the story."
        },
        "materiality": {
          "default": "clean-cutout",
          "options": [
            "clean-cutout",
            "paper-layer",
            "photo-stage"
          ],
          "description": "Rendering/material treatment of supporting visual layers."
        },
        "layout_energy": {
          "default": "bold",
          "options": [
            "bold",
            "spacious",
            "layered"
          ],
          "description": "Composition energy and occupied space."
        },
        "cover_device": {
          "default": "hero-object",
          "options": [
            "hero-object",
            "oversized-type",
            "reveal-window"
          ],
          "description": "First slide reveal/hook grammar."
        },
        "image_role": {
          "default": "concept-support",
          "options": [
            "concept-support",
            "object-only",
            "minimal"
          ],
          "description": "Images never include final brand typography or logos."
        },
        "sequence_arc": {
          "default": "hook-reveal",
          "options": [
            "hook-reveal",
            "contrast-payoff",
            "journey"
          ],
          "description": "How the concept unfolds through multiple slides."
        }
      },
