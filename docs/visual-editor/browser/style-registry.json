    {
      "style_id": "data-atlas",
      "name": "Data Atlas",
      "brand": "asyada-egitim",
      "category": "instagram-carousel",
      "version": "0.1.0",
      "status": "review-only",
      "source_path": "brands/asyada-egitim/styles/instagram-carousel/data-atlas/style.json",
      "source_blob_sha": "2235ffc05cb3c203f795a93810d393d73815df97",
      "description": "Evidence-led information design: numerical anchors, comparison matrices, timelines and modular diagram grids. A navigable information map, not an editorial-photo campaign.",
      "default_preset": "metrics-overview",
      "presets": {
        "metrics-overview": {
          "label": "Metrik atlası",
          "summary": "Number-led overview, modular grids and comparative evidence.",
          "variants": {
            "structure": "modular-grid",
            "evidence_focus": "metrics",
            "content_density": "balanced",
            "cover_device": "hero-number",
            "media_role": "diagram-first",
            "sequence_arc": "overview-detail"
          }
        },
        "timeline-path": {
          "label": "Zaman çizelgesi",
          "summary": "Sequential milestones and verified dates anchored on a timeline rail.",
          "variants": {
            "structure": "timeline",
            "evidence_focus": "steps",
            "content_density": "spacious",
            "cover_device": "timeline-start",
            "media_role": "text-only",
            "sequence_arc": "steps-outcome"
          }
        },
        "comparison-led": {
          "label": "Karşılaştırma panosu",
          "summary": "Side-by-side differences, verified dimensions and compact ranking.",
          "variants": {
            "structure": "comparison",
            "evidence_focus": "comparison",
            "content_density": "dense",
            "cover_device": "index-map",
            "media_role": "diagram-first",
            "sequence_arc": "question-evidence"
          }
        }
      },
      "variation_axes": {
        "structure": {
          "default": "modular-grid",
          "options": [
            "modular-grid",
            "timeline",
            "comparison"
          ],
          "description": "Main factual navigation structure."
        },
        "evidence_focus": {
          "default": "metrics",
          "options": [
            "metrics",
            "steps",
            "ranking",
            "comparison"
          ],
          "description": "Which kind of evidence receives the largest visual role."
        },
        "content_density": {
          "default": "balanced",
          "options": [
            "spacious",
            "balanced",
            "dense"
          ],
          "description": "How much verified information is displayed per slide; never compromise readability."
        },
        "cover_device": {
          "default": "hero-number",
          "options": [
            "hero-number",
            "index-map",
            "timeline-start"
          ],
          "description": "A cover that communicates structured information."
        },
        "media_role": {
          "default": "diagram-first",
          "options": [
            "diagram-first",
            "verified-photo",
            "text-only"
          ],
          "description": "Verified media role, not permission to invent sources."
        },
        "sequence_arc": {
          "default": "overview-detail",
          "options": [
            "overview-detail",
            "question-evidence",
            "steps-outcome"
          ],
          "description": "Explanatory order across multiple slides."
        }
      },
      "palette": {
        "paper": "#F7F3E9",
        "red": "#BD2120",
        "ink": "#1D2027"
      },
